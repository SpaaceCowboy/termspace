# Installed as /etc/termspace/server.env with mode 0600.
TERMSPACE_ALLOWED_ORIGIN=https://termspace.example.com
TERMSPACE_PROJECT_ROOT=/srv/projects
TERMSPACE_DATABASE_PATH=/var/lib/termspace/termspace.db
TERMSPACE_HOST=127.0.0.1
TERMSPACE_PORT=3001
TERMSPACE_SESSION_MEMORY_MAX_BYTES=4294967296
TERMSPACE_SESSION_SHELL=/usr/bin/zsh

# Optional Web Push configuration.
# TERMSPACE_VAPID_PUBLIC_KEY=
# TERMSPACE_VAPID_PRIVATE_KEY=
# TERMSPACE_VAPID_SUBJECT=mailto:you@example.com
