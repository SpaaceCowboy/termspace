[Unit]
Description=Termspace online SQLite backup
Documentation=file:/opt/termspace/deploy/systemd/README.md
After=local-fs.target

[Service]
Type=oneshot
User=root
LogNamespace=termspace
EnvironmentFile=-/etc/termspace/runtime.env
EnvironmentFile=/etc/termspace/server.env
WorkingDirectory=/opt/termspace/server
ExecStart=/usr/bin/env node dist/database/backup-cli.js
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
NoNewPrivileges=yes
UMask=0077
ReadOnlyPaths=/var/lib/termspace
ReadWritePaths=/var/backups/termspace
