# Installed as /etc/termspace/runtime.env. systemd does not load interactive
# shell startup files, so Node and both agent CLIs must be reachable here.
# Adapt versioned paths when Node is upgraded; `node --version` must be >=22.
PATH=/home/spacecowboy/.nvm/versions/node/v24.16.0/bin:/home/spacecowboy/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
HOME=/home/spacecowboy
SHELL=/usr/bin/zsh
