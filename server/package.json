{
  "name": "@termspace/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsc -p tsconfig.build.json && node dist/database/migrate-cli.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "seed:user": "tsc -p tsconfig.build.json && node dist/seed/seed-user-cli.js",
    "test": "tsc -p tsconfig.build.json && node --test dist/*.test.js dist/**/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.11.3",
    "otplib": "^13.4.1",
    "zod": "^4.4.3"
  }
}
